{
  "name": "@stipnd/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-side client for Stipnd: pays 402 challenges from a stipend, within policy. Also owner-side helpers for issuing credentials.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./owner": {
      "types": "./src/owner/index.ts",
      "default": "./src/owner/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "prettier --check src test"
  },
  "dependencies": {
    "@stipnd/protocol": "workspace:*",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/permissions": "^5.6.3",
    "@zerodev/sdk": "^5.5.10",
    "tslib": "^2.8.1",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
