    "lint": "prettier --check src"
  },
  "dependencies": {
    "@stipnd/protocol": "workspace:*",
    "@stipnd/sdk": "workspace:*",
    "dotenv": "^17.2.3",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
