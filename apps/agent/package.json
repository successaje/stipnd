{
  "name": "@stipnd/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Reference agent: buys from a Stipnd merchant using a stipend credential. Normal, over-cap, and loop modes for demos and e2e checks.",
  "type": "module",
  "bin": {
    "stipnd-agent": "./src/cli.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
