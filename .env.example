# ---------- Chain ----------
# Arbitrum Sepolia by default. Local Anvil is 31337.
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ---------- Contracts (filled by `pnpm --filter contracts deploy:*`) ----------
NEXT_PUBLIC_STIPEND_HUB_ADDRESS=
NEXT_PUBLIC_MERCHANT_REGISTRY_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
NEXT_PUBLIC_TOKEN_SYMBOL=USDC
NEXT_PUBLIC_TOKEN_DECIMALS=6

# ---------- Account abstraction (ZeroDev) ----------
# Create a project at https://dashboard.zerodev.app and paste the project id.
NEXT_PUBLIC_ZERODEV_PROJECT_ID=
# Optional overrides; defaults derive from the project id.
NEXT_PUBLIC_BUNDLER_RPC=
NEXT_PUBLIC_PAYMASTER_RPC=
# Passkey relying party (defaults to the current origin in the browser).
NEXT_PUBLIC_PASSKEY_SERVER_URL=

# ---------- Reference merchant (apps/merchant) ----------
MERCHANT_PORT=4020
# Receives payments. Any address; use the key below only for `pnpm --filter @stipnd/merchant register`.
MERCHANT_ADDRESS=
MERCHANT_PRIVATE_KEY=
MERCHANT_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
MERCHANT_HUB_ADDRESS=
MERCHANT_PUBLIC_URL=http://localhost:4020

# ---------- Reference agent (apps/agent) ----------
# Issued by the owner app on the stipend's Connect tab. Shown once.
STIPND_CREDENTIAL=
STIPND_MERCHANT_URL=http://localhost:4020

# ---------- Deploy (packages/contracts) ----------
DEPLOYER_PRIVATE_KEY=
ARBISCAN_API_KEY=
