{
  "name": "stipnd",
  "private": true,
  "version": "0.1.0",
  "description": "Budgets for AI agents that the chain enforces.",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @stipnd/web build",
    "dev": "pnpm --filter @stipnd/web dev",
    "dev:merchant": "pnpm --filter @stipnd/merchant dev",
    "agent": "pnpm --filter @stipnd/agent start",
    "lint": "pnpm -r --filter=!@stipnd/contracts lint",
    "typecheck": "pnpm -r --filter=!@stipnd/contracts typecheck",
    "test": "pnpm -r --filter=!@stipnd/contracts test",
    "test:contracts": "pnpm --filter @stipnd/contracts test",
    "abi:export": "pnpm --filter @stipnd/contracts build && pnpm --filter @stipnd/contracts abi:export",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
